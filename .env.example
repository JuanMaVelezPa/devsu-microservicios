# PostgreSQL (credenciales = docker-compose postgres service)
POSTGRES_DB=devsu_db
POSTGRES_USER=devsu
POSTGRES_PASSWORD=devsu_secret
# Host 5433 evita conflicto con PostgreSQL local en 5432 (Windows)
POSTGRES_PORT=5433
# local spring-boot:run -> localhost | contenedor MS en compose (F10) -> postgres
POSTGRES_HOST=localhost

# Kafka (localhost:9092 = puerto expuesto por devsu-kafka en el host)
KAFKA_PORT=9092
KAFKA_BROKER=localhost:9092
KAFKA_TOPIC_CLIENT_EVENTS=devsu.client.events

# Outbox publisher (client-service): intervalo del cron y lote por ciclo
OUTBOX_PUBLISH_INTERVAL_MS=3000
OUTBOX_BATCH_SIZE=50

# Kafka consumer (account-service): registros max por poll (default Spring: 500)
KAFKA_CONSUMER_MAX_POLL_RECORDS=500
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Microservicios (F10: contenedores; local: spring-boot:run)
CLIENT_SERVICE_PORT=8081
ACCOUNT_SERVICE_PORT=8082

# --- Modo Docker Compose (F10) ---
# Los servicios client-service y account-service sobreescriben en compose:
#   POSTGRES_HOST=postgres  POSTGRES_PORT=5432  KAFKA_BROKER=kafka:29092
# Para spring-boot:run en el host, mantener los valores de arriba (localhost/5433).
