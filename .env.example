# PostgreSQL
POSTGRES_DB=devsu_db
POSTGRES_USER=devsu
POSTGRES_PASSWORD=devsu_secret
POSTGRES_PORT=5432
# local spring-boot:run -> localhost | contenedor MS en compose (F10) -> postgres
POSTGRES_HOST=localhost

# Kafka
KAFKA_PORT=9092
KAFKA_BROKER=kafka:9092
KAFKA_TOPIC_CLIENT_EVENTS=devsu.client.events

# Observabilidad
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Microservicios (F10: contenedores; local: spring-boot:run)
CLIENT_SERVICE_PORT=8081
ACCOUNT_SERVICE_PORT=8082
