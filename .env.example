# PostgreSQL (credenciales = docker-compose postgres service)
POSTGRES_DB=devsu_db
POSTGRES_USER=devsu
POSTGRES_PASSWORD=devsu_secret
# Host 5433 evita conflicto con PostgreSQL local en 5432 (Windows)
POSTGRES_PORT=5433
# local spring-boot:run -> localhost | contenedor MS en compose (F10) -> postgres
POSTGRES_HOST=localhost

# Kafka (localhost:9092 = puerto expuesto por devsu-kafka en el host)
KAFKA_PORT=9092
KAFKA_BROKER=localhost:9092
KAFKA_TOPIC_CLIENT_EVENTS=devsu.client.events

# Observabilidad
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Microservicios (F10: contenedores; local: spring-boot:run)
CLIENT_SERVICE_PORT=8081
ACCOUNT_SERVICE_PORT=8082
