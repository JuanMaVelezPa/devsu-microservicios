          ]
        },
        {
          "name": "F7 - Cuentas (utilidades)",
          "item": [
            {
              "name": "GET listar cuentas",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{accountBaseUrl}}/api/cuentas?page=0&size=20",
                  "host": ["{{accountBaseUrl}}"],
                  "path": ["api", "cuentas"],
                  "query": [
                    { "key": "page", "value": "0" },
                    { "key": "size", "value": "20" }
                  ]
                }
              }
            },
            {
              "name": "GET cuenta por id",
              "request": {
                "method": "GET",
                "header": [],
                "url": "{{accountBaseUrl}}/api/cuentas/{{cuentaId}}"
              }
            },
            {
              "name": "PUT actualizar cuenta (tipo/estado)",
              "request": {
                "method": "PUT",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"tipoCuenta\": \"CORRIENTE\",\n  \"estado\": \"ACTIVA\"\n}"
                },
                "url": "{{accountBaseUrl}}/api/cuentas/{{cuentaId}}"
              }
            },
            {
              "name": "POST cuenta duplicada (409 CUENTA_DUPLICADA)",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"clienteId\": {{joseClienteId}},\n  \"numeroCuenta\": \"478758\",\n  \"tipoCuenta\": \"AHORROS\",\n  \"saldoInicial\": 100,\n  \"estado\": \"ACTIVA\"\n}"
                },
                "url": "{{accountBaseUrl}}/api/cuentas"
              }
            },
            {
              "name": "POST sin cliente_referencia (422 CLIENTE_NOT_FOUND)",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"clienteId\": 9999,\n  \"numeroCuenta\": \"111111\",\n  \"tipoCuenta\": \"AHORROS\",\n  \"saldoInicial\": 100,\n  \"estado\": \"ACTIVA\"\n}"
                },
                "url": "{{accountBaseUrl}}/api/cuentas"
              }
            }
          ]
        },
