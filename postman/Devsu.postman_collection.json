        {
          "name": "05 Caso 5 - Reporte",
          "item": [
            {
              "name": "GET Reporte Marianela Montalvo feb-2022",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "pm.test('Status 200', () => pm.response.to.have.status(200));",
                      "const res = pm.response.json();",
                      "pm.test('success true', () => pm.expect(res.success).to.be.true);",
                      "pm.test('cliente Marianela Montalvo', () => pm.expect(res.data.cliente).to.eql('Marianela Montalvo'));",
                      "const cuentas = res.data.cuentas;",
                      "pm.test('2 cuentas en reporte', () => pm.expect(cuentas).to.have.lengthOf(2));",
                      "const c225 = cuentas.find(c => c.numeroCuenta === '225487');",
                      "const c496 = cuentas.find(c => c.numeroCuenta === '496825');",
                      "pm.test('cuenta 225487 saldo 700 y deposito 600', () => {",
                      "  pm.expect(c225).to.exist;",
                      "  pm.expect(c225.saldoActual).to.eql(700);",
                      "  pm.expect(c225.movimientos[0].fecha).to.eql('2022-02-10T10:00:00');",
                      "  pm.expect(c225.movimientos[0].valor).to.eql(600);",
                      "  pm.expect(c225.movimientos[0].saldoResultante).to.eql(700);",
                      "});",
                      "pm.test('cuenta 496825 saldo 0 y retiro 540', () => {",
                      "  pm.expect(c496).to.exist;",
                      "  pm.expect(c496.saldoActual).to.eql(0);",
                      "  pm.expect(c496.movimientos[0].fecha).to.eql('2022-02-08T08:30:00');",
                      "  pm.expect(c496.movimientos[0].valor).to.eql(-540);",
                      "  pm.expect(c496.movimientos[0].saldoResultante).to.eql(0);",
                      "});"
                    ],
                    "type": "text/javascript"
                  }
                }
              ],
