                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"clienteId\": {{marianelaClienteId}},\n  \"numeroCuenta\": \"225487\",\n  \"tipoCuenta\": \"CORRIENTE\",\n  \"saldoInicial\": 100,\n  \"estado\": \"ACTIVA\"\n}"
                },
                "url": "{{accountBaseUrl}}/api/cuentas"
              }
