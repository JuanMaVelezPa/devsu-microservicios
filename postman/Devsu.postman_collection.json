                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"clienteId\": {{juanClienteId}},\n  \"numeroCuenta\": \"495878\",\n  \"tipoCuenta\": \"AHORROS\",\n  \"saldoInicial\": 0,\n  \"estado\": \"ACTIVA\"\n}"
                },
                "url": "{{accountBaseUrl}}/api/cuentas"
              }
            },
            {
              "name": "POST 496825 Marianela (Ahorros 540)",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"clienteId\": {{marianelaClienteId}},\n  \"numeroCuenta\": \"496825\",\n  \"tipoCuenta\": \"AHORROS\",\n  \"saldoInicial\": 540,\n  \"estado\": \"ACTIVA\"\n}"
                },
                "url": "{{accountBaseUrl}}/api/cuentas"
              }
            }
          ]
        },
        {
          "name": "F7 - Caso 3 - Cuenta adicional",
          "item": [
            {
              "name": "POST 585545 Jose Lema (Corriente 1000)",
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"clienteId\": {{joseClienteId}},\n  \"numeroCuenta\": \"585545\",\n  \"tipoCuenta\": \"CORRIENTE\",\n  \"saldoInicial\": 1000,\n  \"estado\": \"ACTIVA\"\n}"
                },
                "url": "{{accountBaseUrl}}/api/cuentas"
