                  "script": {
                    "exec": [
                      "pm.test('Status 409', () => pm.response.to.have.status(409));",
                      "const res = pm.response.json();",
                      "pm.test('CLIENTE_DUPLICADO', () => {",
                      "  pm.expect(res.success).to.be.false;",
                      "  pm.expect(res.error.code).to.eql('CLIENTE_DUPLICADO');",
