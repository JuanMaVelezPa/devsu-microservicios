    {
      "key": "clientBaseUrl",
      "value": "http://localhost:8081"
    },
    {
      "key": "accountBaseUrl",
      "value": "http://localhost:8082"
    },
    {
      "key": "joseClienteId",
      "value": "1"
    },
    {
      "key": "marianelaClienteId",
      "value": "2"
    },
    {
      "key": "juanClienteId",
      "value": "3"
    },
    {
      "key": "cuentaId",
      "value": "1"
    },
    {
      "key": "movimientoId",
      "value": "1"
    }
  ],
