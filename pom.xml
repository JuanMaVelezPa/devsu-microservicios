<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.0</version>
        <relativePath/>
    </parent>

    <groupId>com.devsu</groupId>
    <artifactId>devsu</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Devsu - Microservicios bancarios</name>
    <description>Prueba tecnica Devsu: microservicios bancarios con API REST, Kafka, Transactional Outbox y Clean Architecture</description>
    <url>https://github.com/JuanMaVelezPa/devsu-microservicios</url>

    <developers>
        <developer>
            <id>juanmavelez</id>
            <name>Juan Manuel Velez Parra</name>
            <email>juanmavelezpa@gmail.com</email>
            <url>https://www.linkedin.com/in/juanmavelezdev/</url>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/JuanMaVelezPa/devsu-microservicios.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/JuanMaVelezPa/devsu-microservicios.git</developerConnection>
        <url>https://github.com/JuanMaVelezPa/devsu-microservicios</url>
        <tag>HEAD</tag>
    </scm>

    <modules>
        <module>client-service</module>
        <module>account-service</module>
    </modules>

    <properties>
        <java.version>25</java.version>
        <logstash-logback-encoder.version>8.1</logstash-logback-encoder.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>net.logstash.logback</groupId>
                <artifactId>logstash-logback-encoder</artifactId>
                <version>${logstash-logback-encoder.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

</project>
