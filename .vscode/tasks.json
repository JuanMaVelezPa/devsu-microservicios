{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Maven: verify",
      "type": "shell",
      "command": ".\\mvnw.cmd",
      "args": ["clean", "verify"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$maven"]
    },
    {
      "label": "Maven: test",
      "type": "shell",
      "command": ".\\mvnw.cmd",
      "args": ["test"],
      "group": "test",
      "problemMatcher": ["$maven"]
    },
    {
      "label": "Maven: client-service spring-boot:run",
      "type": "shell",
      "command": ".\\mvnw.cmd",
      "args": ["-pl", "client-service", "spring-boot:run"],
      "isBackground": true,
      "problemMatcher": ["$maven"]
    },
    {
      "label": "Maven: account-service spring-boot:run",
      "type": "shell",
      "command": ".\\mvnw.cmd",
      "args": ["-pl", "account-service", "spring-boot:run"],
      "isBackground": true,
      "problemMatcher": ["$maven"]
    }
  ]
}
